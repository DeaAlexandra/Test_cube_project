        <mxCell id="b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;KIELI&lt;/b&gt;&lt;br&gt;1 = Suomi &amp;nbsp; 2 = English" vertex="1">
          <mxGeometry height="60" width="210" x="620" y="390" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Kieli vaihdettu&lt;br&gt;→ päävalikko" vertex="1">
