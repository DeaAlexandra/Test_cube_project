          <mxGeometry height="60" width="190" x="40" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="db4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Lähetys epäonnistui&lt;br&gt;tulos säilyy, voi yrittää uudelleen" vertex="1">
          <mxGeometry height="60" width="200" x="290" y="1070" as="geometry" />
