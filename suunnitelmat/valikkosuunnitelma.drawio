        <mxCell id="db1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="&lt;b&gt;TULOS ODOTTAA LÄHETYSTÄ&lt;/b&gt; (työmuisti)&lt;br&gt;* = lähetä &amp;nbsp; 0 = mittaa uudelleen &amp;nbsp; # = valikko&lt;br&gt;&lt;i&gt;1 paikka per testi (7 kpl), mukana mittaushetken tunnus&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="400" x="60" y="850" as="geometry" />
