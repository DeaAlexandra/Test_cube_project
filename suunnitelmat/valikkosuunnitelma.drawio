        </mxCell>
        <mxCell id="l4a" value="RYHMÄTUNNUS&#xa;Muoto: VVLNNNN&#xa;esim. 26A1234&#xa;*=poista #=valikko" style="rounded=0;html=0;whiteSpace=nowrap;fontFamily=Courier New;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#1f3d7a;fontColor=#e6f0ff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="560" y="85" width="210" height="95" as="geometry" />
