        <mxCell id="d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;DIGITAALINEN&lt;/b&gt; – valitse kanava&lt;br&gt;1 = Tuuli &amp;nbsp;2 = Sade&lt;br&gt;3 = Sisäkosteus &amp;nbsp;4 = Ulkokosteus" vertex="1">
