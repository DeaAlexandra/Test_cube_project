        <mxCell id="l2b" value="1=1.7V  2=2.2V&#xa;3=2.7V  4=3.2V&#xa;5=3.9V&#xa;0=tietokantamittaus" style="rounded=0;html=0;whiteSpace=nowrap;fontFamily=Courier New;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#1f3d7a;fontColor=#e6f0ff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
