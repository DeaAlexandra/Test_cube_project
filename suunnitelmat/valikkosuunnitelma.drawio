        </mxCell>
        <mxCell id="l3a" value="TIETOKANTAMITTAUS&#xa;Tuulen suunta&#xa;Ryhmä: 26A1234&#xa;*=lähetä #=valikko" style="rounded=0;html=0;whiteSpace=nowrap;fontFamily=Courier New;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#1f3d7a;fontColor=#e6f0ff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
