        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;RYHMÄ&lt;/b&gt;&lt;br&gt;1 = Syötä tunnus &amp;nbsp; 2 = Tyhjennä&lt;br&gt;Nykyinen: 26A1234 / ei asetettu" vertex="1">
          <mxGeometry height="80" width="260" x="880" y="270" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;SYÖTÄ TUNNUS&lt;/b&gt; (VVLNNNN)&lt;br&gt;VV = 0–9, L = A–D, NNNN = 0–9&lt;br&gt;väärät napit ohitetaan&lt;br&gt;* = poista merkki" vertex="1">
          <mxGeometry height="90" width="220" x="860" y="400" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="7. merkki → tallennus automaattisesti&lt;br&gt;&quot;Tallennettu: 26A1234&quot;" vertex="1">
          <mxGeometry height="60" width="220" x="860" y="530" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;TYHJENNÄ&lt;/b&gt;&lt;br&gt;Poistetaanko tunnus ja&lt;br&gt;odottavat tulokset?&lt;br&gt;* = kyllä &amp;nbsp; # = ei" vertex="1">
          <mxGeometry height="90" width="200" x="1110" y="400" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Tunnus ja odottavat&lt;br&gt;tulokset poistettu" vertex="1">
          <mxGeometry height="60" width="180" x="1120" y="530" as="geometry" />
