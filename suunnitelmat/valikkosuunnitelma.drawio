      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Käynnistys&lt;/b&gt;&lt;br&gt;virta päälle: tunnus ja tulokset tyhjiä" vertex="1">
          <mxGeometry height="70" width="270" x="400" y="20" as="geometry" />
        </mxCell>
        <mxCell id="m" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="&lt;b&gt;PÄÄVALIKKO&lt;/b&gt;&lt;br&gt;A = Analoginen &amp;nbsp; D = Digitaalinen&lt;br&gt;B = Asetukset &amp;nbsp; C = Ryhmä&lt;br&gt;&lt;i&gt;(ryhmätunnus näkyy, jos asetettu)&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="300" x="385" y="120" as="geometry" />
        </mxCell>
        <mxCell id="rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;size=14;" value="&lt;b&gt;SÄÄNNÖT (koko laite)&lt;/b&gt;&lt;br&gt;# = paluu päävalikkoon kaikkialta&lt;br&gt;* = vahvista / uusi / poista merkki&lt;br&gt;0 = tietokantamittaus (vain kun tunnus asetettu)&lt;br&gt;Mittaus onnistuu aina myös ilman tunnusta&lt;br&gt;Virta pois → tunnus ja tulokset katoavat (vain työmuisti)" vertex="1">
          <mxGeometry height="120" width="360" x="760" y="10" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;ANALOGINEN&lt;/b&gt; – valitse anturi&lt;br&gt;1 = Lämpötila&lt;br&gt;2 = Valo&lt;br&gt;3 = Tuulen suunta" vertex="1">
          <mxGeometry height="80" width="250" x="40" y="270" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;TESTIPISTE&lt;/b&gt;&lt;br&gt;1–5 = yksittäinen piste&lt;br&gt;0 = tietokantamittaus" vertex="1">
          <mxGeometry height="70" width="250" x="40" y="390" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Yksittäinen mittaus&lt;br&gt;DAC → 1 s → 16 näytteen ka" vertex="1">
          <mxGeometry height="70" width="130" x="10" y="510" as="geometry" />
        </mxCell>
        <mxCell id="a5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;TULOS&lt;/b&gt;&lt;br&gt;OK / VIRHE&lt;br&gt;* = uusi &amp;nbsp;# = valikko&lt;br&gt;&lt;i&gt;ei tallennu&lt;/i&gt;" vertex="1">
