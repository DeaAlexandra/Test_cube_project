        <mxCell id="d2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Mittaus käynnissä (4 s)&lt;br&gt;# = keskeytä" vertex="1">
          <mxGeometry height="60" width="180" x="370" y="390" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;TULOS&lt;/b&gt;&lt;br&gt;leveys ka, U ka, x/y&lt;br&gt;* = uusi &amp;nbsp;0 = tietokantaan&lt;br&gt;# = valikko" vertex="1">
          <mxGeometry height="80" width="180" x="370" y="490" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Ryhmätunnus&lt;br&gt;asetettu?" vertex="1">
          <mxGeometry height="90" width="140" x="390" y="610" as="geometry" />
