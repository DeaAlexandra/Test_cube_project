          <mxGeometry x="40" y="60" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l1a" value="SÄÄASEMA TESTAUS&#xa;A=analog  D=digit.&#xa;B=asetukset&#xa;C=ryhmä: 26A1234" style="rounded=0;html=0;whiteSpace=nowrap;fontFamily=Courier New;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#1f3d7a;fontColor=#e6f0ff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="210" height="95" as="geometry" />
        </mxCell>
        <mxCell id="l1b" value="Valmis.&#xa;Valitse A,B,C tai D&#xa;&#xa;" style="rounded=0;html=0;whiteSpace=nowrap;fontFamily=Courier New;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#1f3d7a;fontColor=#e6f0ff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="270" y="85" width="210" height="95" as="geometry" />
        </mxCell>
        <!-- 2 Analoginen testipiste -->
