        <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;ASETUKSET&lt;/b&gt;&lt;br&gt;1 = Kieli&lt;br&gt;&lt;i&gt;(myöhemmin: 2 = Verkko, 3 = Laitetiedot)&lt;/i&gt;" vertex="1">
